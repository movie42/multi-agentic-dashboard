{
  "name": "multi-agentic-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3100",
    "lint": "eslint",
    "desktop:build": "next build && node scripts/build-desktop.mjs",
    "desktop:install": "node scripts/install-desktop.mjs",
    "desktop": "bun run desktop:build && bun run desktop:install",
    "hook:install": "node scripts/install-permission-hook.mjs",
    "hook:uninstall": "node scripts/install-permission-hook.mjs --uninstall",
    "snapshot:install": "node scripts/install-snapshot-hook.mjs",
    "snapshot:uninstall": "node scripts/install-snapshot-hook.mjs --uninstall"
  },
  "dependencies": {
    "@shikijs/core": "3.23.0",
    "@shikijs/engine-javascript": "3.23.0",
    "@shikijs/langs": "3.23.0",
    "@shikijs/themes": "3.23.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "44.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "electron"
  ]
}
