{
  "name": "multi-agentic-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3100",
    "lint": "eslint",
    "desktop:build": "next build && node scripts/build-desktop.mjs",
    "desktop:install": "node scripts/install-desktop.mjs",
    "desktop": "bun run desktop:build && bun run desktop:install && bun run skills:install",
    "hook:install": "node scripts/install-permission-hook.mjs",
    "hook:uninstall": "node scripts/install-permission-hook.mjs --uninstall",
    "snapshot:install": "node scripts/install-snapshot-hook.mjs",
    "snapshot:uninstall": "node scripts/install-snapshot-hook.mjs --uninstall",
    "skills:install": "node scripts/install-skills.mjs",
    "skills:uninstall": "node scripts/install-skills.mjs --uninstall",
    "test": "vitest run --project node --project dom",
    "test:watch": "vitest --project node --project dom",
    "e2e": "playwright test",
    "test:contract": "vitest run --project contract"
  },
  "dependencies": {
    "@shikijs/core": "3.23.0",
    "@shikijs/engine-oniguruma": "3.23.0",
    "@shikijs/langs": "3.23.0",
    "@shikijs/themes": "3.23.0",
    "@tanstack/react-query": "^5.105.3",
    "lru-cache": "^11.5.3",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "44.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "trustedDependencies": [
    "electron"
  ]
}
